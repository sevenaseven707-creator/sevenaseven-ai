{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sevenaseven-ai",
  "main": "worker.js",
  "compatibility_date": "2025-02-14",
  "compatibility_flags": [
    "nodejs_compat_v2"
  ],
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "BOT_KV",
      "id": "<YOUR_KV_NAMESPACE_ID>"
    }
  ]
}
